    <properties>
        <embabel-agent.version>1.5.4</embabel-agent.version>
        <!--
            tuProlog stays at 1.0.4. Releases 1.1.0 to 1.1.5 depend on a kotlin-stdlib-common 2.2 jar
            that Kotlin does not publish, and releases from 1.2.0 are built with Kotlin 2.4.
        -->
        <tuprolog.version>1.0.4</tuprolog.version>
        <drivine.version>0.6.2</drivine.version>
        <!--
            Docker Engine API version the Testcontainers docker-java client talks. The client's
            default is below the engine minimum, which disables container-backed tests; pin it here
            and reference it from the surefire system properties below.
        -->
        <testcontainers.docker.api.version>1.41</testcontainers.docker.api.version>
        <!--
            JetBrains annotations, for @ApiStatus on experimental API. Not managed by
            embabel-agent-dependencies, so the version is set here and every module inherits it.
        -->
        <jetbrains.annotations.version>26.0.2</jetbrains.annotations.version>
        <!--
            mockito-kotlin version is also not managed by embabel-agent-dependencies, so the version
            is set here and test scope dependencies inherit it.
        -->
        <mockito-kotlin.version>5.4.0</mockito-kotlin.version>
        <!-- check compares each module's public API with its committed listing; update rewrites the listing -->
        <api.listing.mode>check</api.listing.mode>
        <!--
            Kotlin ABI tools version for the API listings. It is kept apart from kotlin.version so a
            compiler upgrade cannot change the listing format in the same change. It reads the
            compiler's metadata, and its versions follow Kotlin's, so the build stops when Kotlin's
            major and minor version passes this one (see the enforcer plugin below).
        -->
        <abi-tools.version>2.2.21</abi-tools.version>
        <!-- Reads the source file name of a compiled class, so the listing can leave generated code out -->
        <asm.version>9.8</asm.version>
        <!-- A module with generated sources sets this to their root, and the listing leaves them out -->
        <api.listing.generated.sources></api.listing.generated.sources>
        <!-- The api-listing-update profile sets this, so update mode knows the class directory was emptied -->
        <api.listing.fresh-classes>false</api.listing.fresh-classes>
    </properties>

