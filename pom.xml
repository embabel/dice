    <repositories>
        <repository>
            <id>embabel-releases</id>
            <url>https://repo.embabel.com/artifactory/libs-release</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>embabel-snapshots</id>
            <url>https://repo.embabel.com/artifactory/libs-snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!--
                        Compares a module's compiled public API with the listing committed under its api
                        directory, so an API change always shows up in review. A module opts in by naming
                        this plugin in its own build.
                    -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>abi-tools</artifactId>
                            <version>${abi-tools.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>public-api-listing</id>
                            <phase>process-classes</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target xmlns:if="ant:if">
                                    <!-- Update mode relies on the api-listing-update profile having emptied the class directory -->
                                    <fail message="Pass -Dapi.listing.mode=update on the command line, so the api-listing-update profile empties the class directory before compile.">
                                        <condition>
                                            <and>
                                                <equals arg1="${api.listing.mode}" arg2="update"/>
                                                <not>
                                                    <equals arg1="${api.listing.fresh-classes}" arg2="true"/>
                                                </not>
                                            </and>
                                        </condition>
                                    </fail>
                                    <!--
                                        Compiled from build-support's sources on disk into this module's own
                                        target, so a module built alone with -pl needs nothing from the reactor.
                                        javac skips the compile when the class is newer than its source. A stamp
                                        file holds the classpath and compiler settings of the last compile, and a
                                        change to either (another abi-tools or ASM version, say) deletes the class
                                        to force a compile. Line numbers stay in, so a stack trace names its lines.
                                    -->
                                    <property name="api.listing.classes" location="${project.build.directory}/api-listing"/>
                                    <property name="api.listing.stamp" location="${project.build.directory}/api-listing.classpath"/>
                                    <pathconvert property="api.listing.classpath" refid="maven.plugin.classpath"/>
                                    <property name="api.listing.compile"
                                              value="release=${maven.compiler.target} debug=true ${api.listing.classpath}"/>
                                    <loadfile property="api.listing.compiled" srcFile="${api.listing.stamp}"
                                              failonerror="false" quiet="true"/>
                                    <condition property="api.listing.recompile">
                                        <not>
                                            <equals arg1="${api.listing.compile}" arg2="${api.listing.compiled}"/>
                                        </not>
                                    </condition>
                                    <delete dir="${api.listing.classes}" if:set="api.listing.recompile"/>
                                    <mkdir dir="${api.listing.classes}"/>
                                    <javac srcdir="${maven.multiModuleProjectDirectory}/build-support/src/main/java"
                                           destdir="${api.listing.classes}" classpathref="maven.plugin.classpath"
                                           includeantruntime="false" release="${maven.compiler.target}" encoding="UTF-8"
                                           debug="true"/>
                                    <echo file="${api.listing.stamp}" message="${api.listing.compile}"/>
                                    <!-- Forked, because the program ends with System.exit -->
                                    <java classname="com.embabel.dice.apilisting.ApiListing" fork="true" failonerror="false"
                                          resultproperty="api.listing.exit" errorproperty="api.listing.error">
                                        <classpath>
                                            <pathelement location="${api.listing.classes}"/>
                                            <path refid="maven.plugin.classpath"/>
                                        </classpath>
                                        <arg value="${api.listing.mode}"/>
                                        <arg file="${project.build.outputDirectory}"/>
                                        <arg file="${project.basedir}/api"/>
                                        <arg value="${project.artifactId}"/>
                                        <arg value="--generated=${api.listing.generated.sources}"/>
                                        <arg value="--source=${project.basedir}/src/main/kotlin"/>
                                        <arg value="--source=${project.basedir}/src/main/java"/>
                                    </java>
                                    <!-- Put the program's own explanation in the build error, so it shows in quiet mode too -->
                                    <fail message="${api.listing.error}">
                                        <condition>
                                            <not>
                                                <equals arg1="${api.listing.exit}" arg2="0"/>
                                            </not>
                                        </condition>
                                    </fail>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!--
                    The ABI tools read the Kotlin compiler's metadata, so they must be at least as new as
                    Kotlin. Their versions follow Kotlin's, and the build stops at validate when Kotlin's
                    major and minor version is ahead of abi-tools.version.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The build parent's dependency convergence report stays off, as it was before this plugin was named here -->
                        <id>enforce-versions</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>abi-tools-keeps-up-with-kotlin</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <fail>true</fail>
                            <rules combine.self="override">
                                <evaluateBeanshell>
                                    <condition><![CDATA[
                                        String[] kotlin = "${kotlin.version}".split("[.-]");
                                        String[] abiTools = "${abi-tools.version}".split("[.-]");
                                        Integer.parseInt(kotlin[0]) * 1000 + Integer.parseInt(kotlin[1])
                                            <= Integer.parseInt(abiTools[0]) * 1000 + Integer.parseInt(abiTools[1])
                                    ]]></condition>
                                    <message>Kotlin ${kotlin.version} is newer than the Kotlin ABI tools ${abi-tools.version} that write the public API listings. Raise abi-tools.version in the root pom.xml to a release with the same major and minor version as Kotlin, then regenerate the listings with ./mvnw -B -Dapi.listing.mode=update process-classes and review the difference.</message>
                                </evaluateBeanshell>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Register src/main/kotlin and src/main/java as compile source roots (configured in
                    embabel-build-parent), so the sources jar below contains the Kotlin code, not just resources.
                -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Attach a sources jar to every module; Maven Central requires one. Configured in embabel-build-parent. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <!--
                    Pin the Docker Engine API version the Testcontainers docker-java client uses;
                    its default is below the engine minimum and disables container-backed tests.
                    Honoured only as a JVM system property, and tests fork, so it must be set here.
                    The value lives in the testcontainers.docker.api.version property above.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${testcontainers.docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Integration tests, the user guide and the API listing program are built by default but are not published.
            activeByDefault profiles switch off when any other profile in this POM is activated,
            so the Maven Central release (-Psonatype) builds only the published modules above.
        -->
        <profile>
            <id>unpublished-modules</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>dice-integration-tests</module>
                <module>dice-user-guide</module>
                <module>build-support</module>
            </modules>
        </profile>
        <!--
            Declared here (the release setup itself lives in embabel-build-parent) so that
            -Psonatype deactivates unpublished-modules.
        -->
        <profile>
            <id>sonatype</id>
        </profile>
        <!--
            Regenerating the API listings with -Dapi.listing.mode=update starts from an empty class
            directory, so a class left from an earlier build cannot reach a listing. The Kotlin compiler
            rebuilds every class on each run anyway, and a check build never runs this. Activating this
            profile also switches off unpublished-modules, which have no listings.
        -->
        <profile>
            <id>api-listing-update</id>
            <activation>
                <property>
                    <name>api.listing.mode</name>
                    <value>update</value>
                </property>
            </activation>
            <properties>
                <api.listing.fresh-classes>true</api.listing.fresh-classes>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-antrun-plugin</artifactId>
                            <executions>
                                <execution>
                                    <id>public-api-listing-fresh-classes</id>
                                    <phase>initialize</phase>
                                    <goals>
                                        <goal>run</goal>
                                    </goals>
                                    <configuration>
                                        <target>
                                            <!-- Incremental Kotlin compiles only changed files, so the listing would be partial -->
                                            <fail message="Regenerate the API listings without -Dkotlin.compiler.incremental=true, so every class is compiled.">
                                                <condition>
                                                    <equals arg1="${kotlin.compiler.incremental}" arg2="true"/>
                                                </condition>
                                            </fail>
                                            <delete dir="${project.build.outputDirectory}"/>
                                        </target>
                                    </configuration>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

</project>
