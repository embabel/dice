<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.embabel.dice</groupId>
        <artifactId>dice-parent</artifactId>
        <version>0.5.0-SNAPSHOT</version>
    </parent>
    <artifactId>dice-starters</artifactId>
    <packaging>pom</packaging>
    <name>Dice Starters</name>
    <description>Dice Starters</description>
    <url>https://github.com/embabel/dice</url>

    <scm>
        <url>https://github.com/embabel/dice</url>
        <connection>scm:git:https://github.com/embabel/dice.git</connection>
        <developerConnection>scm:git:https://github.com/embabel/dice.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>dice-starter</module>
        <module>dice-starter-neo4j</module>
        <module>dice-starter-mcp</module>
    </modules>

    <build>
        <!--
            In pluginManagement rather than plugins, so these run only where a jar is built: in each starter,
            and not in this pom-only parent.
        -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <!--
                        A starter is only a list of dependencies, so it has no code to document or ship as source.
                        Maven Central still wants a sources jar and a javadoc jar next to every jar it publishes,
                        and the source plugin and Dokka both skip a module with no code. So every starter builds
                        the two jars itself, holding only Maven's own metadata, in every build and under -Psonatype alike.
                    -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>empty-sources-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <classifier>sources</classifier>
                                <classesDirectory>${project.build.directory}/empty-archive</classesDirectory>
                                <forceCreation>true</forceCreation>
                                <skipIfEmpty>false</skipIfEmpty>
                            </configuration>
                        </execution>
                        <execution>
                            <id>empty-javadoc-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                            <configuration>
                                <classifier>javadoc</classifier>
                                <classesDirectory>${project.build.directory}/empty-archive</classesDirectory>
                                <forceCreation>true</forceCreation>
                                <skipIfEmpty>false</skipIfEmpty>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- The sources jar above is the only one, so a resource added to a starter cannot attach a second -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
